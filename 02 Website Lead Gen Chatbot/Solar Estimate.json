      "id": "f31b5139-b2ec-45bf-8769-4be79ddd9206",
      "name": "Geocode Address (Nominatim)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        432,
        544
      ]
    },
    {
      "parameters": {
        "jsCode": "const solar = $input.item.json;\nconst trigger = $('When Executed by Another Workflow').item.json;\n\n// ac_annual = kWh produced per year by a 1kW reference system at this location\nconst acAnnualPerKw = solar.outputs?.ac_annual ?? null;\nconst monthlyBill = Number(trigger.monthlyBill) || null;\n\n// Assumptions - adjust as needed\nconst assumedRate = 0.15; // $/kWh average utility rate\nconst panelWattage = 400; // watts per panel\n\nconst monthlyUsageKwh = monthlyBill ? monthlyBill / assumedRate : null;\nconst annualUsageKwh = monthlyUsageKwh ? monthlyUsageKwh * 12 : null;\nconst requiredSystemKw = (annualUsageKwh && acAnnualPerKw) ? annualUsageKwh / acAnnualPerKw : null;\nconst maxPanels = requiredSystemKw ? Math.ceil((requiredSystemKw * 1000) / panelWattage) : null;\nconst estimatedAnnualSavingsUsd = annualUsageKwh ? Math.round(annualUsageKwh * assumedRate) : null;\n\nif (!acAnnualPerKw) {\n  return [{ json: { error: 'Could not find solar data for this address. Please check the address and try again.' } }];\n}\n\nreturn [{\n  json: {\n    address: trigger.address,\n    monthlyBill,\n    maxPanels,\n    estimatedYearlyEnergyKwh: annualUsageKwh ? Math.round(annualUsageKwh) : null,\n    estimatedAnnualSavingsUsd,\n    notes: 'Estimate based on NREL PVWatts solar production data for this location, sized to roughly offset current usage at an assumed $0.15/kWh rate. Actual results vary by roof condition, shading, and local rates/incentives.'\n  }\n}];"
      },
      "id": "e730b240-4d50-424c-86b8-61335ff3daa8",
      "name": "Format Solar Estimate Response1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
