    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-goog-api-key",
              "value": "YOUR_GEMINI_API_KEY_HERE"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { role: \"user\", parts: [ { text: \"You are analyzing a photo of a receipt. Extract the following fields and return ONLY raw valid JSON, no markdown code fences, no explanation:\\n{ \\\"vendor\\\": string, \\\"expense_date\\\": string in YYYY-MM-DD, \\\"total\\\": number, \\\"currency\\\": 3-letter code like USD, \\\"tax\\\": number or null, \\\"category\\\": one of Meals/Travel/Office Supplies/Software/Other, \\\"items\\\": array of short strings, \\\"confidence\\\": number between 0 and 1 }\" }, { inline_data: { mime_type: $json.mimeType, data: $json.base64Image } } ] } ] }) }}",
        "options": {}
      },
      "id": "83d2a1de-d39e-456d-85cc-59f66ec3d87c",
      "name": "Extract Receipt Data (Gemini)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -928,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json/g, '').replace(/```/g, '').trim();\nlet data;\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Could not parse Gemini response as JSON. Raw response was: ' + raw);\n}\nreturn [{\n  json: {\n    vendor: data.vendor || 'Unknown',\n    expense_date: data.expense_date || '',\n    total: Number(data.total) || 0,\n    currency: data.currency || 'USD',\n    tax: data.tax ?? null,\n    category: data.category || 'Other',\n    items: Array.isArray(data.items) ? data.items.join(', ') : '',\n    confidence: data.confidence ?? null\n  }\n}];"
      },
      "id": "1702bc83-2076-4360-af50-4e09261dde5b",
      "name": "Parse Receipt JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
