      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nreturn [{\n  json: {\n    base64Image: buffer.toString('base64'),\n    mimeType: $input.item.binary.data.mimeType || 'image/jpeg'\n  }\n}];"
